{
  "version": 2,
  "builds": [
    {
      "src": "BookMyShow/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "BookMyShow/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "BookMyShow.settings"
  }
}